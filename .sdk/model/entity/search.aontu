              }
              {
                ex: ""
                k: "query"
                n: "q"
                or: "q"
                r: false
                t: "`$STRING`"
              }
              {
                ex: ""
                k: "query"
                n: "sort"
                or: "sort"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "work_key"
                or: "work_key"
                r: false
                t: "`$ANY`"
              }
            ]
          }
          m: "GET"
          o: "/search/editions.json"
          q: {
            "$action": "edition"
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "search"
            }
            {
              lit: "editions.json"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
